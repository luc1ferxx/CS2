# Browser-facing API origin. This must be public from the user's browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_PROVIDER=steam
# Authentication credentials remain server-only. The browser uses the API's
# HttpOnly session cookie. This public provider label must match AUTH_PROVIDER;
# do not add Steam/OIDC tokens or session secrets here.

# Optional: where an uninvited player can ask for beta access (a mailto: or
# form URL). The not-invited sign-in page shows "申请内测资格" only when this is
# set. Like every NEXT_PUBLIC_ value it is inlined at build time.
# NEXT_PUBLIC_BETA_CONTACT_URL=mailto:beta@example.com
