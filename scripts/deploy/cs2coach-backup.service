# Nightly CS2 Coach backup (docs/vps_deploy_v1.md). Install as root:
#   cp scripts/deploy/cs2coach-backup.service scripts/deploy/cs2coach-backup.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now cs2coach-backup.timer
# Edit User/Group/paths if bootstrap.sh ran with a non-default APP_USER or APP_DIR.
# Run once by hand: systemctl start cs2coach-backup.service; journalctl -u cs2coach-backup.service
[Unit]
Description=CS2 Coach backup (Postgres dump + artifact bucket mirror)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=cs2coach
Group=cs2coach
WorkingDirectory=/opt/cs2coach
ExecStart=/bin/bash /opt/cs2coach/scripts/deploy/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
