API_BASE_URL=http://localhost:8000
RENDER_WORKER_TOKEN=dev-render-worker-token
WORK_DIR=.render-worker-work
POLL_INTERVAL_SECONDS=5

# Optional. Point this at a small local .mp4 to prove the manifest -> media upload
# -> completed callback -> frontend playback chain without launching CS2/Steam/OBS/ffmpeg.
# DEV_FAKE_VIDEO_PATH=/absolute/path/to/dev-placeholder.mp4

# Optional for CS2ManualAdapter. These are checked and written into operator
# instructions only. The runner does not start Steam, start CS2, run playdemo,
# or call OBS/ffmpeg.
# CS2_INSTALL_DIR=/absolute/path/to/Counter-Strike Global Offensive
# STEAM_USER_DATA_DIR=/absolute/path/to/Steam/userdata
# CS2_MANUAL_OUTPUT_FILENAME={job_id}.mp4
