API_BASE_URL=http://localhost:8000
RENDER_WORKER_TOKEN=dev-render-worker-token
WORK_DIR=.render-worker-work
POLL_INTERVAL_SECONDS=5
RENDER_ADAPTER=fake-video

# Optional. Point this at a small local .mp4 to prove the manifest -> media upload
# -> completed callback -> frontend playback chain without launching CS2/Steam/OBS/ffmpeg.
# DEV_FAKE_VIDEO_PATH=/absolute/path/to/dev-placeholder.mp4

# Optional for CS2ManualAdapter. These are checked and written into operator
# instructions only. The runner does not start Steam, start CS2, run playdemo,
# or call OBS/ffmpeg.
# CS2_INSTALL_DIR=/absolute/path/to/Counter-Strike Global Offensive
# STEAM_USER_DATA_DIR=/absolute/path/to/Steam/userdata
# CS2_MANUAL_OUTPUT_FILENAME={job_id}.mp4

# Explicitly opt in on an operator-controlled Windows render PC. This adapter
# starts CS2 via CSDM/HLAE. API containers separately use RENDER_WORKER_MODE=external.
# RENDER_ADAPTER=csdm
# CSDM_EXECUTABLE=C:/cs2-render/tools/csdm/cs-demo-manager.exe
# CSDM_CLI_ENTRYPOINT=C:/cs2-render/tools/csdm/resources/app.asar/cli.js
# FFMPEG_EXECUTABLE=C:/cs2-render/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_EXECUTABLE=C:/cs2-render/tools/ffmpeg/bin/ffprobe.exe
# CSDM_TIMEOUT_SECONDS=1800
# CSDM_RECORDING_SYSTEM=HLAE
# Set CSDM_RECORDING_SYSTEM=CS for native startmovie/TGA + FFmpeg fallback.
# MAX_SOURCE_BYTES=2147483648
# RENDER_STOP_FILE=C:/cs2-render/work/renderer.stop
