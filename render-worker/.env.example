# External render-worker runner settings.
API_BASE_URL=http://localhost:8000
RENDER_WORKER_TOKEN=dev-render-worker-token
WORK_DIR=.render-worker-work
POLL_INTERVAL_SECONDS=5
RENDER_ADAPTER=fake-video

# Fake adapter: local MP4 uploaded to prove manifest -> media -> callback.
DEV_FAKE_VIDEO_PATH=

# Manual adapter: written into operator instructions only.
CS2_INSTALL_DIR=
STEAM_USER_DATA_DIR=
CS2_MANUAL_OUTPUT_FILENAME={job_id}.mp4

# Opt-in operator renderer. Set RENDER_ADAPTER=csdm only on the chosen render PC.
# The API stack separately needs RENDER_WORKER_MODE=external.
CSDM_EXECUTABLE=
# Windows installer uses an Electron executable and the bundled CLI entrypoint:
# CSDM_EXECUTABLE=C:/cs2-render/tools/csdm/cs-demo-manager.exe
# CSDM_CLI_ENTRYPOINT=C:/cs2-render/tools/csdm/resources/app.asar/cli.js
CSDM_CLI_ENTRYPOINT=
FFMPEG_EXECUTABLE=
FFPROBE_EXECUTABLE=
CSDM_TIMEOUT_SECONDS=1800
# CS uses native startmovie/TGA recording when HLAE is incompatible (more scratch disk).
# Native mode also requires CS2_INSTALL_DIR; pre-existing movie captures are refused.
CSDM_RECORDING_SYSTEM=HLAE
MAX_SOURCE_BYTES=2147483648
# Optional absolute stop flag for a hidden poll process. Runner never deletes it.
RENDER_STOP_FILE=
