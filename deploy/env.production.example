# Production env for the single-VPS deploy (docs/vps_deploy_v1.md).
#
#   cp deploy/env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production
#   sed -i 's/coach\.example\.com/<your domain>/g' deploy/.env.production
#
# then replace every CHANGE_ME. deploy.sh refuses to run while any value
# (comments are ignored) still holds CHANGE_ME or coach.example.com. The real
# file is git-ignored; keep a copy in a password manager (the Steam credential
# key below cannot be recovered).
# Values are read literally: no ${VAR} references, no inline comments.

# --- Edge (Caddy, automatic HTTPS) ------------------------------------------
# Bare host name whose DNS A/AAAA record points straight at the VPS.
# Cloudflare DNS is fine, but the record must be DNS-only (grey cloud).
# Friends-only setup: a free DuckDNS name such as myname.duckdns.org works
# as is (not sslip.io / nip.io; see docs/vps_deploy_v1.md).
SITE_DOMAIN=coach.example.com
ACME_EMAIL=CHANGE_ME@example.org

# --- Public origin: one https origin for pages and API -----------------------
# Production rejects split origins; all four must be https://SITE_DOMAIN.
BACKEND_PUBLIC_URL=https://coach.example.com
FRONTEND_PUBLIC_URL=https://coach.example.com
CORS_ORIGINS=https://coach.example.com
# Baked into the browser bundle at build time; redeploy after changing.
NEXT_PUBLIC_API_BASE_URL=https://coach.example.com
# Where an uninvited player can ask for access (mailto: or form URL). Optional.
NEXT_PUBLIC_BETA_CONTACT_URL=
# Contact shown on the public /privacy page for privacy questions and removal
# requests: an email address (rendered as mailto:), an http(s) URL, or plain
# text. Required: other players in an uploaded .dem were never invited and have
# no other way to ask for a removal, so deploy.sh refuses to run without it.
# Build-time: redeploy after changing.
NEXT_PUBLIC_PRIVACY_CONTACT=CHANGE_ME@example.org
# Where the VPS runs, shown on /privacy (e.g. 日本东京). Optional; empty shows
# "海外 VPS，具体地区由站长部署时选定". Build-time: redeploy after changing.
NEXT_PUBLIC_DATA_REGION=

# --- Sign-in ------------------------------------------------------------------
AUTH_PROVIDER=steam
# Informational: compose derives the frontend's provider label from AUTH_PROVIDER.
NEXT_PUBLIC_AUTH_PROVIDER=steam
# Server-only 32-hex key from https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=CHANGE_ME
# Invited SteamID64s, comma separated (e.g. 76561198000000001,76561198000000002).
# * opens sign-in to every Steam account; do not use it for the invite-only beta.
STEAM_LOGIN_ALLOWLIST=CHANGE_ME
# 32 random bytes, URL-safe base64. Generate once and never rotate casually:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
STEAM_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME
STEAM_CREDENTIAL_ENCRYPTION_KEY_VERSION=prod-v1
# Sign-in lasts while in use: a session ends after 1 hour without requests, a
# request in its last half hour renews it to a full hour, and it never lasts
# past 24 hours from sign-in (the cap must be >= the idle window, <= 86400).
# /privacy states these facts: update frontend/app/privacy/page.tsx first.
AUTH_SESSION_TTL_SECONDS=3600
AUTH_SESSION_MAX_AGE_SECONDS=86400

# --- Database -----------------------------------------------------------------
# Only takes effect when the postgres volume is first created. Hex keeps the
# DATABASE_URL that compose builds from it valid:   openssl rand -hex 24
POSTGRES_DB=cs2coach
POSTGRES_USER=cs2coach
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis (sign-in sessions, job queue) --------------------------------------
# Required. Redis sits on the internal backend network with postgres; api and
# worker get the password inside their REDIS_URL, the parse child never does.
# Hex keeps that URL valid:   openssl rand -hex 24
# Changing it takes a deploy.sh run (redis, api and worker restart; sessions and
# queued jobs survive in the append-only file).
REDIS_PASSWORD=CHANGE_ME

# --- Parse worker memory (VPS sizing) -------------------------------------------
# Hard cap for the worker container, parse child included (memory and swap). A
# parse that outgrows it is killed inside the container and reported as
# PARSE_OUT_OF_MEMORY instead of pushing the whole VPS into swap. Leave about
# 1 GB for postgres, redis, api, frontend and caddy:
#   4 GB VPS (friends-only minimum): 3g    8 GB VPS (recommended): 6g
# The worker logs one JSON line per finished job with peakRssMiB; size this
# (and, below it, PARSE_MEMORY_LIMIT_BYTES, the per-parse cap: default 4 GiB,
# at least 2 GiB) from those numbers, not from the .dem file size.
WORKER_MEM_LIMIT=3g

# --- Artifact storage (private S3-compatible bucket, e.g. Cloudflare R2) ------
# R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto, and an
# API token with Object Read & Write scoped to this bucket only.
OBJECT_STORAGE_BUCKET=cs2coach-artifacts
OBJECT_STORAGE_PREFIX=cs2-artifacts-v1
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT_URL=https://CHANGE_ME.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=CHANGE_ME
OBJECT_STORAGE_SECRET_ACCESS_KEY=CHANGE_ME

# --- Upload quotas (production only; 0 turns a limit off) --------------------
MAX_DEMO_UPLOAD_BYTES=1073741824
DEMO_UPLOAD_DAILY_LIMIT=10
DEMO_ACTIVE_PARSE_LIMIT=2
PARSE_QUEUE_GLOBAL_LIMIT=50

# --- Chunked upload sessions (all modes, not only production) -----------------
# The browser uploads a .dem in parts to the VPS disk (named volume
# upload-staging), then `complete` hands them to the normal intake and R2.
# Disk need: up to UPLOAD_SESSION_GLOBAL_LIMIT x MAX_DEMO_UPLOAD_BYTES (6 GiB)
# plus UPLOAD_STAGING_MIN_FREE_BYTES; Postgres and Redis share that disk.
# Part size: 4-32 MiB, a whole number of MiB. Parallel parts per session 1-6.
UPLOAD_PART_BYTES=8388608
UPLOAD_MAX_PARALLEL_PARTS=4
UPLOAD_PART_POOL=8
# Hard limit from creation, not sliding. /privacy tells users unfinished uploads
# are deleted after 24 hours: update that page (frontend/app/privacy/page.tsx)
# before raising this.
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_SESSION_GLOBAL_LIMIT=6
# A new session needs its file size plus this much free space on the volume.
UPLOAD_STAGING_MIN_FREE_BYTES=5368709120

# --- Render worker ------------------------------------------------------------
# No GPU worker in this deploy: clips stay hidden and unprocessed jobs fail
# with a clear message. The token must still be a non-default secret:
#   openssl rand -hex 32
RENDER_CLIPS_ENABLED=0
RENDER_WORKER_MODE=fallback
RENDER_WORKER_TOKEN=CHANGE_ME

# --- Backups (scripts/deploy/backup.sh, restore.sh) --------------------------
# A second private bucket, with its own token scoped to it. The artifact bucket
# is read through the OBJECT_STORAGE_* credentials above.
BACKUP_RCLONE_PROVIDER=Cloudflare
BACKUP_BUCKET=cs2coach-backups
BACKUP_S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
BACKUP_LOCAL_DIR=/var/backups/cs2coach
# Newest N local dumps kept; remote dumps and replaced artifacts older than N days are deleted.
# /privacy tells users deleted data leaves the backups within 30 days: do not raise
# these without updating that page (frontend/app/privacy/page.tsx).
BACKUP_LOCAL_KEEP=14
BACKUP_REMOTE_KEEP_DAYS=30
# 1 mirrors the artifact bucket into BACKUP_BUCKET/artifacts after the dump.
BACKUP_SYNC_ARTIFACTS=1

# --- Alerts (scripts/deploy/watch.sh every 5 min, backup.sh) -----------------
# All optional; empty turns each one off. Messages name a check, a state and a
# short reason only: no account, SteamID, file name or IP.
# One plain-text line per state change. Sent as the POST body, e.g. ntfy:
#   https://ntfy.sh/<long-random-topic>
# A URL containing {message} gets the URL-encoded line there, fetched with GET:
#   Telegram: https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>&text={message}
#   Server酱: https://sctapi.ftqq.com/<SendKey>.send?title={message}
# Test it: bash scripts/deploy/watch.sh --test-alert
ALERT_WEBHOOK_URL=
# GET after every watch.sh pass with all checks ok (healthchecks.io-style
# dead-man switch: period 5 min, grace >= 15 min so a deploy fits). It alerts
# when the pings stop, which covers the VPS itself being down.
DEADMAN_PING_URL=
# GET after every complete nightly backup (a second check, period 1 day).
BACKUP_PING_URL=
# watch.sh thresholds; 0 turns a check off.
WATCH_DISK_PERCENT=85
WATCH_BACKUP_MAX_AGE_HOURS=26

# --- Deploy script ------------------------------------------------------------
DEPLOY_BRANCH=main
# The first deploy also waits for the Let's Encrypt certificate.
DEPLOY_HEALTH_TIMEOUT_SECONDS=300
