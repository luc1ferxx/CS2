# Production env for the single-VPS deploy (docs/vps_deploy_v1.md).
#
#   cp deploy/env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production
#   sed -i 's/coach\.example\.com/<your domain>/g' deploy/.env.production
#
# then replace every CHANGE_ME. deploy.sh refuses to run while any value
# (comments are ignored) still holds CHANGE_ME or coach.example.com. The real
# file is git-ignored; keep a copy in a password manager (the Steam credential
# key below cannot be recovered).
# Values are read literally: no ${VAR} references, no inline comments.

# --- Edge (Caddy, automatic HTTPS) ------------------------------------------
# Bare host name whose DNS A/AAAA record points straight at the VPS.
# Cloudflare DNS is fine, but the record must be DNS-only (grey cloud).
# Friends-only setup: a free DuckDNS name such as myname.duckdns.org works
# as is (not sslip.io / nip.io; see docs/vps_deploy_v1.md).
SITE_DOMAIN=coach.example.com
ACME_EMAIL=CHANGE_ME@example.org

# --- Public origin: one https origin for pages and API -----------------------
# Production rejects split origins; all four must be https://SITE_DOMAIN.
BACKEND_PUBLIC_URL=https://coach.example.com
FRONTEND_PUBLIC_URL=https://coach.example.com
CORS_ORIGINS=https://coach.example.com
# Baked into the browser bundle at build time; redeploy after changing.
NEXT_PUBLIC_API_BASE_URL=https://coach.example.com
# Where an uninvited player can ask for access (mailto: or form URL). Optional.
NEXT_PUBLIC_BETA_CONTACT_URL=

# --- Sign-in ------------------------------------------------------------------
AUTH_PROVIDER=steam
# Informational: compose derives the frontend's provider label from AUTH_PROVIDER.
NEXT_PUBLIC_AUTH_PROVIDER=steam
# Server-only 32-hex key from https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=CHANGE_ME
# Invited SteamID64s, comma separated (e.g. 76561198000000001,76561198000000002).
# * opens sign-in to every Steam account; do not use it for the invite-only beta.
STEAM_LOGIN_ALLOWLIST=CHANGE_ME
# 32 random bytes, URL-safe base64. Generate once and never rotate casually:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
STEAM_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME
STEAM_CREDENTIAL_ENCRYPTION_KEY_VERSION=prod-v1
AUTH_SESSION_TTL_SECONDS=3600

# --- Database -----------------------------------------------------------------
# Only takes effect when the postgres volume is first created. Hex keeps the
# DATABASE_URL that compose builds from it valid:   openssl rand -hex 24
POSTGRES_DB=cs2coach
POSTGRES_USER=cs2coach
POSTGRES_PASSWORD=CHANGE_ME

# --- Artifact storage (private S3-compatible bucket, e.g. Cloudflare R2) ------
# R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto, and an
# API token with Object Read & Write scoped to this bucket only.
OBJECT_STORAGE_BUCKET=cs2coach-artifacts
OBJECT_STORAGE_PREFIX=cs2-artifacts-v1
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT_URL=https://CHANGE_ME.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=CHANGE_ME
OBJECT_STORAGE_SECRET_ACCESS_KEY=CHANGE_ME

# --- Upload quotas (production only; 0 turns a limit off) --------------------
MAX_DEMO_UPLOAD_BYTES=1073741824
DEMO_UPLOAD_DAILY_LIMIT=10
DEMO_ACTIVE_PARSE_LIMIT=2
PARSE_QUEUE_GLOBAL_LIMIT=50

# --- Render worker ------------------------------------------------------------
# No GPU worker in this deploy: clips stay hidden and unprocessed jobs fail
# with a clear message. The token must still be a non-default secret:
#   openssl rand -hex 32
RENDER_CLIPS_ENABLED=0
RENDER_WORKER_MODE=fallback
RENDER_WORKER_TOKEN=CHANGE_ME

# --- Backups (scripts/deploy/backup.sh, restore.sh) --------------------------
# A second private bucket, with its own token scoped to it. The artifact bucket
# is read through the OBJECT_STORAGE_* credentials above.
BACKUP_RCLONE_PROVIDER=Cloudflare
BACKUP_BUCKET=cs2coach-backups
BACKUP_S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
BACKUP_LOCAL_DIR=/var/backups/cs2coach
# Newest N local dumps kept; remote dumps and replaced artifacts older than N days are deleted.
BACKUP_LOCAL_KEEP=14
BACKUP_REMOTE_KEEP_DAYS=30
# 1 mirrors the artifact bucket into BACKUP_BUCKET/artifacts after the dump.
BACKUP_SYNC_ARTIFACTS=1

# --- Deploy script ------------------------------------------------------------
DEPLOY_BRANCH=main
# The first deploy also waits for the Let's Encrypt certificate.
DEPLOY_HEALTH_TIMEOUT_SECONDS=300
