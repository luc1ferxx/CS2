# Local and Docker Compose defaults for the mock MVP.
# Replace hostnames and credentials before using a public preview.

POSTGRES_DB=cs2coach
POSTGRES_USER=cs2coach
POSTGRES_PASSWORD=cs2coach

DATABASE_URL=postgresql+psycopg2://cs2coach:cs2coach@postgres:5432/cs2coach
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAME=cs2-demo-jobs

BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_PROVIDER=steam
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication must be explicit. Local Compose uses the development owner
# override; hosted production defaults to Steam OpenID.
AUTH_MODE=development
AUTH_PROVIDER=steam
STEAM_AUTH_STATE_COOKIE_NAME=__Host-cs2_steam_state
STEAM_OPENID_NONCE_TTL_SECONDS=600
# Server-only. Optional for local profile enrichment, but required by production
# match sync. Inject the real key through deployment secrets, never NEXT_PUBLIC_*.
STEAM_WEB_API_KEY=
# Public, deterministic development-only AES-256 key. Production and preview
# must inject a different 32-byte URL-safe base64 key from a secret store.
STEAM_CREDENTIAL_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
STEAM_CREDENTIAL_ENCRYPTION_KEY_VERSION=dev-v1
STEAM_SYNC_MAX_MATCHES=20
STEAM_SYNC_TIMEOUT_SECONDS=5
STEAM_SYNC_RETRY_BASE_SECONDS=30
STEAM_SYNC_RETRY_MAX_SECONDS=3600
# V1 has manual Sync now only; startup fails closed if this is enabled.
STEAM_SCHEDULED_SYNC_ENABLED=0
# Stage 3 ships with no licensed automatic Demo source. Startup accepts only
# disabled, and the unsupported replay-CDN experiment must remain off.
STEAM_DEMO_PROVIDER=disabled
STEAM_DEMO_EXPERIMENTAL_REPLAY_CDN_ENABLED=0
# Reserved for a separately reviewed, formally licensed provider adapter. Use
# comma-separated exact lowercase DNS hosts only; the disabled provider uses none.
STEAM_DEMO_DOWNLOAD_ALLOWED_HOSTS=
STEAM_DEMO_DOWNLOAD_MAX_BYTES=536870912
STEAM_DEMO_DOWNLOAD_MAX_REDIRECTS=3
STEAM_DEMO_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=5
STEAM_DEMO_DOWNLOAD_READ_TIMEOUT_SECONDS=10
STEAM_DEMO_DOWNLOAD_TOTAL_TIMEOUT_SECONDS=60
STEAM_DEMO_DOWNLOAD_GLOBAL_CONCURRENCY=4
STEAM_DEMO_DOWNLOAD_OWNER_CONCURRENCY=1
STEAM_DEMO_DOWNLOAD_CONCURRENCY_LEASE_SECONDS=120
# Legacy provider-compatible OIDC settings. Set AUTH_PROVIDER=oidc to use them.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_ALGORITHMS=RS256,ES256
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URL=
OIDC_REDIRECT_URI=
AUTH_COOKIE_SECURE=0
AUTH_SESSION_COOKIE_NAME=__Host-cs2_session
AUTH_STATE_COOKIE_NAME=__Host-cs2_oidc_state
AUTH_SESSION_TTL_SECONDS=3600
AUTH_LOGIN_TTL_SECONDS=300
AUTH_CLOCK_SKEW_SECONDS=30

# Stage 3 artifact storage. Local is for development/test only; production
# requires the private S3-compatible adapter. Leave credentials blank when the
# runtime supplies them through its workload identity/credential chain.
ARTIFACT_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PREFIX=cs2-artifacts-v1
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
ARTIFACT_QUARANTINE_TTL_SECONDS=3600
MAX_DEMO_UPLOAD_BYTES=1073741824
MAX_VIDEO_UPLOAD_BYTES=2147483648
MAX_REPLAY_ARTIFACT_BYTES=134217728
UPLOAD_CHUNK_BYTES=1048576

ARTIFACT_STORAGE_ROOT=/data
REPLAY_STORAGE_DIR=/data/replays
DEMO_UPLOAD_STORAGE_DIR=/data/uploads
VIDEO_STORAGE_DIR=/data/videos
SUMMARY_STORAGE_DIR=/data/summaries
# Optional. Set to the public backend origin when media links must be absolute.
MEDIA_URL_BASE=

DEV_USER_ID=dev-user
MAX_RENDER_CLIP_SECONDS=60
RENDER_WORKER_TOKEN=dev-render-worker-token
# external keeps clip jobs queued for the standalone GPU worker; fallback reports it unavailable.
RENDER_WORKER_MODE=fallback

# render-worker/runner.py settings for fake/manual adapter validation.
API_BASE_URL=http://localhost:8000
WORK_DIR=.render-worker-work
POLL_INTERVAL_SECONDS=5
DEV_FAKE_VIDEO_PATH=
CS2_INSTALL_DIR=
STEAM_USER_DATA_DIR=
CS2_MANUAL_OUTPUT_FILENAME={job_id}.mp4

# Optional sample-demo smoke validation. Keep sample files outside git.
# Example: SAMPLE_DEMO_PATH=/absolute/path/to/sample-demos/match.dem
SAMPLE_DEMO_PATH=
SAMPLE_DEMO_NAME=
REQUIRE_SAMPLE_DEMO=0
